# Copy to .env.local. Never commit .env.local or put tokens in these files.
# Leave the project ID empty to run the site on built-in default content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only set when the app is mounted below the domain root (Webflow Cloud mount path), e.g. /offsite
NEXT_PUBLIC_BASE_PATH=
